# ---------------------------------------------------------
# Sonara Backend Environment Configuration
# ---------------------------------------------------------

# Core Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Sonara — Audio Intelligence & Knowledge Retrieval"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_chars_min
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sonara_user
POSTGRES_PASSWORD=sonara_password
POSTGRES_DB=sonara_db
# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://sonara_user:sonara_password@localhost:5432/sonara_db
# Sync URL for Alembic migrations and synchronous scripts (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://sonara_user:sonara_password@localhost:5432/sonara_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sonara-recordings
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# AI / Provider Settings (Optional for foundation startup)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Audio, Chunking & Retrieval Parameters
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
MAX_AUDIO_UPLOAD_SIZE_MB=250

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

